%% ============================================================
%% 社区服务信息主视觉设计 · Agent Skill 工作流程图（Mermaid 源码）
%% 位置：社区服务信息主视觉设计/01_工作流程图.mmd
%% 版本 v1.0 ｜ 配套：01_工作流程图.png / .pdf、04_SKILL.md（同目录）
%%
%% 用法：整段粘进 Mermaid Live (mermaid.live)、ProcessOn、boardmix、
%%       Obsidian、Typora、VS Code（Markdown Preview Mermaid）即可渲染。
%%
%% 配色规范（课程要求，改动前请确认）：
%%   青蓝圆角矩形  = AI 任务        class ai
%%   橙色菱形      = Human Gate     class gate
%%   白底灰框      = 输入/输出/中间产物  class io
%%   橙色虚线箭头  = 不通过时的回退路径  用 -.-> 表示
%%
%% 给接手 AI 的说明：
%%   1. 主干是 14 个节点（N1→N14），5 个 Human Gate（G1→G5）；
%%   2. 每个 Gate 后面必须跟着一条 -.-> 回退边，回退目标写在边的标签里；
%%   3. 派生物料（N9）是可选分支，不允许阻断主干；
%%   4. 落到 SKILL.md 时：节点 → 编号步骤，菱形 → [HUMAN GATE]，
%%      虚线 → “不通过回步骤 N”。
%% ============================================================

flowchart LR

%% ---------- 第 1 段：输入 → 冻结 ----------
N1["N1 经典输入包<br/>brief · 服务对象 · 服务事项<br/>时间地点 · 行动步骤 · 注意事项<br/>图形素材 · 机构事实清单"]
N2("N2 主题分类与路由<br/>产物：theme.yaml<br/>领域 D01–D15 · 骨架 S1–S9<br/>受众 · 时效 · 权威等级")
G1{"G1<br/>分类与路由确认"}
N3("N3 事实结构化<br/>产物：fact-table.md<br/>图形素材清单<br/>官方来源记录")
G2{"G2<br/>事实与母本校对"}
N4("N4 方向候选生成<br/>产物：视觉方向 ≥3<br/>+ Tokens 建议<br/>只描述、不落地")
G3{"G3<br/>设计系统冻结"}

N1 --> N2
N2 --> G1
G1 --> N3
N3 --> G2
G2 --> N4
N4 --> G3

%% ---------- 第 2 段：成稿 ----------
N5("N5 主视觉线框<br/>产物：2–3 版骨架线框<br/>按已冻结的骨架 S1–S9<br/>只定结构、不做修饰")
N6("N6 图形素材统一化<br/>产物：图标清单<br/>线宽 · 圆角 · 用色规则<br/>素材授权记录")
N7("N7 中文版入版排版<br/>产物：poster-cn 成稿<br/>母本零改写入版<br/>字号阶梯 · 对比度达标")
G4{"G4<br/>内容与可读性"}
N8("N8 英文版本地化重排<br/>产物：poster-en 成稿<br/>仅双语主题（受众含 A06）<br/>不含国际居民则跳过")
N9("N9 派生物料询问与生成<br/>先问用户是否需要：<br/>信息卡 · 群消息图<br/>导视牌 · 折页")

G3 --> N5
N5 --> N6
N6 --> N7
N7 --> G4
G4 --> N8
N8 --> N9

%% ---------- 第 3 段：校验与交付 ----------
G5{"G5<br/>双语与对外责任"}
N10("N10 授权与合规核查<br/>产物：合规记录<br/>字体 · 素材 · 肖像 · 标识<br/>不新增原文没有的承诺")
N11("N11 导出与命名<br/>产物：A3 画布 PNG + PDF<br/>3 mm 出血 · 裁切线<br/>每语言 2 个文件")
N12("N12 自动化校验<br/>产物：校验报告<br/>母本 100% 比对<br/>字号 / 对比度 / 禁止元素")
N13("N13 技能包打包<br/>产物：SKILL.md<br/>references · scripts<br/>adapters · CHANGELOG")
N14["N14 交付物<br/>中文版 PNG + PDF<br/>英文版（受众含国际居民时）<br/>校验报告 · SKILL.md 技能包<br/>可选派生物料（经用户确认）"]

N9 --> G5
G5 --> N10
N10 --> N11
N11 --> N12
N12 --> N13
N13 --> N14

%% ---------- 5 条回退路径（橙色虚线，每条都要写明回到哪个节点） ----------
G1 -.->|不通过回 N2| N2
G2 -.->|不通过回 N3| N3
G3 -.->|不通过回 N4| N4
G4 -.->|不通过回 N7| N7
G5 -.->|不通过回 N8| N8

%% ---------- 分类底座（挂在 N2 上，用虚线关联，不属于主干） ----------
TAX["本 Skill 的通用分类底座<br/>15 类服务领域 D01–D15<br/>9 种版式骨架 S1–S9<br/>8 类受众 · 4 类时效 · 5 个权威等级"]
TAX -.-> N2

%% ---------- 样式：严格对应课程配色规范 ----------
classDef ai fill:#CFE7EC,stroke:#0F6E80,stroke-width:2px,color:#0A3944,rx:10,ry:10
classDef gate fill:#FBDFBC,stroke:#D2731A,stroke-width:2px,color:#6E3703
classDef io fill:#FFFFFF,stroke:#D8E0E8,stroke-width:2px,color:#1B2A38
classDef tax fill:#F5F8FB,stroke:#0F6E80,stroke-width:1px,stroke-dasharray:4 3,color:#0A3944

class N2,N3,N4,N5,N6,N7,N8,N9,N10,N11,N12,N13 ai
class G1,G2,G3,G4,G5 gate
class N1,N14 io
class TAX tax

%% 回退边染色：连线按声明顺序从 0 开始编号。本图共 24 条连线：
%%   0–17 实线主干（第 1 段 0–5、第 2 段 6–11、第 3 段 12–17）
%%   18–22 五条回退虚线（G1/G2/G3/G4/G5）
%%   23    分类底座关联虚线
%% 如果你增删了任意一条连线，请重新数一遍序号，否则颜色会错位。
linkStyle 18,19,20,21,22,23 stroke:#D2731A,stroke-width:2px,stroke-dasharray:6 4
